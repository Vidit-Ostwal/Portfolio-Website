---
import '../styles/global.css';
import ChatResumeFab from '../components/ChatResumeFab.astro';
import Nav from '../components/Nav.astro';
import { withBase } from '../lib/paths';

interface Props {
  /** Used for previews (Open Graph); the browser tab always shows the site name. */
  title: string;
  description?: string;
  /** Path under `public/` for link previews (Open Graph / Twitter). Default: site photo. */
  image?: string;
  /** Show MapMyVisitors widget in the footer (home page only). */
  showVisitorMap?: boolean;
}
const {
  title: pageTitle,
  description = 'ML/AI Engineer — Vidit Ostwal',
  image = '/photo.png',
  showVisitorMap = false,
} = Astro.props;

const tabTitle = 'Vidit-Ostwal';

/** ISO date from CI (git commit on deploy) or local build time. Baked in at `astro build`. */
const lastUpdated = new Date(
  import.meta.env.PUBLIC_SITE_UPDATED || Date.now()
).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

/** Absolute asset URL for production; falls back to base path in dev. */
function absoluteUrl(rel: string): string {
  const path = rel.startsWith('/') ? rel.slice(1) : rel;
  const siteHref = Astro.site?.href;
  if (siteHref) {
    const base = siteHref.endsWith('/') ? siteHref : `${siteHref}/`;
    return new URL(withBase(`/${path}`), base).href;
  }
  return withBase(`/${path}`);
}

const ogImage = absoluteUrl(image);
const pageUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.href;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (function(){
        var s = localStorage.getItem('theme');
        var q = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', s || (q ? 'dark' : 'light'));
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" type="text/plain" href={withBase('/llms.txt')} title="LLM-readable site summary" />
    <title>{tabTitle}</title>
    <link rel="icon" type="image/svg+xml" href={absoluteUrl('favicon.svg')} sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=Lora:ital,wght@0,500;1,400;1,500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Nav />
    <ChatResumeFab />
    <div class="page-shell">
      <main>
        <slot />
      </main>
      <footer class:list={[{ 'footer--with-map': showVisitorMap }]}>
        {showVisitorMap && (
          <div class="visitor-map-area">
            <section class="visitor-map" id="visitorMap" aria-label="Live visitor map">
              <div class="visitor-map-head">
                <span class="visitor-map-dot" aria-hidden="true"></span>
                <span class="visitor-map-title mono">Visitors right now</span>
              </div>
              {/* Host must have a real width before MapMyVisitors measures it (w=a). */}
              <div class="visitor-map-slot" id="visitorMapHost"></div>
            </section>
          </div>
        )}
        <div class="footer-bar">
          <span class="footer-copy mono">© {new Date().getFullYear()} Vidit Ostwal</span>
          <span class="footer-updated mono">Updated {lastUpdated}</span>
        </div>
      </footer>
    </div>
    <script>
      const io = new IntersectionObserver(
        (es) => es.forEach((e) => e.isIntersecting && e.target.classList.add('visible')),
        { threshold: 0.06 }
      );
      document.querySelectorAll('.fade-in').forEach((el) => io.observe(el));

      // Inject MapMyVisitors after layout so parent width is measurable, then keep it fluid.
      const host = document.getElementById('visitorMapHost');
      if (host) {
        const ASPECT = 2.04;
        const OCEAN = '30455c';
        const LAND = 'ffffff';
        const MAP_SRC =
          `https://mapmyvisitors.com/map.js?cl=${LAND}&co=${OCEAN}&w=a&t=tt&d=OHSakJv8SBdfw4eaSflSdUTUVIQk5_1xQFyPt50u15M`;

        function syncVisitorMapWidth() {
          const widget = document.getElementById('mapmyvisitors-widget');
          const map = host.querySelector('.mapmyvisitors-map');
          if (!widget || !map) return;

          const w = Math.max(180, Math.round(host.clientWidth));
          const h = Math.round(w / ASPECT);
          widget.style.width = `${w}px`;
          map.style.width = `${w}px`;
          map.style.height = `${h}px`;
          map.style.backgroundSize = '100% 100%';
          map.style.backgroundImage =
            `url("https://mapmyvisitors.com/generated_content/backs/bg-w_${w}-co_${OCEAN}-cl_${LAND}.png")`;

          const $ = window.vmap_jq || window.jQuery;
          if ($) {
            const mapObject = $(map).children('.jvectormap-container').data('mapObject');
            mapObject?.updateSize?.();
          }
        }

        // Defer one frame so the host has a laid-out width before the widget reads it.
        requestAnimationFrame(() => {
          if (document.getElementById('mapmyvisitors')) return;
          const script = document.createElement('script');
          script.type = 'text/javascript';
          script.id = 'mapmyvisitors';
          script.src = MAP_SRC;
          script.async = true;
          script.onload = () => {
            // Widget DOM is created synchronously in their main(); sync once it appears.
            let tries = 0;
            const wait = setInterval(() => {
              if (document.getElementById('mapmyvisitors-widget')) {
                syncVisitorMapWidth();
                clearInterval(wait);
              } else if (++tries > 40) {
                clearInterval(wait);
              }
            }, 100);
          };
          host.appendChild(script);
        });

        let resizeTimer;
        window.addEventListener('resize', () => {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(syncVisitorMapWidth, 120);
        });
      }
    </script>
  </body>
</html>

<style>
  footer {
    margin-top: 1.25rem;
    padding: 0;
  }
  footer.footer--with-map {
    padding-top: 0.35rem;
  }

  .footer-bar {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.72rem;
    color: var(--text-3);
    box-sizing: border-box;
  }
  .footer-copy {
    flex-shrink: 0;
  }
  .footer-updated {
    flex-shrink: 0;
    text-align: right;
  }

  /* ── Visitor map (home only): full content width, tracks the screen ── */
  .visitor-map-area {
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto 0.9rem;
    padding: 0 1.5rem;
    box-sizing: border-box;
  }
  .visitor-map {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    overflow: hidden;
  }

  .visitor-map-head {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }
  .visitor-map-title {
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .visitor-map-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #1d9e75;
    flex-shrink: 0;
    animation: visitor-pulse 2.4s ease-out infinite;
  }
  @keyframes visitor-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(29, 158, 117, 0.45); }
    70%  { box-shadow: 0 0 0 6px rgba(29, 158, 117, 0); }
    100% { box-shadow: 0 0 0 0 rgba(29, 158, 117, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .visitor-map-dot { animation: none; }
  }

  .visitor-map-slot {
    position: relative;
    width: 100%;
    display: block;
    line-height: 0;
    background: #30455c;
    min-height: 160px;
  }
  .visitor-map-slot :global(#mapmyvisitors-widget),
  .visitor-map-slot :global(a#mapmyvisitors-widget) {
    display: block !important;
    width: 100% !important;
    max-width: 100% !important;
    min-height: 0 !important;
    margin: 0 !important;
    color: transparent !important;
    text-decoration: none !important;
  }
  .visitor-map-slot :global(.mapmyvisitors-map) {
    width: 100% !important;
    background-size: 100% 100% !important;
  }
  .visitor-map-slot :global(.jvectormap-container) {
    width: 100% !important;
    height: 100% !important;
  }
  /* Strip MapMyVisitors chrome so the card reads as ours */
  .visitor-map-slot :global(mapmyvisitors-logo),
  .visitor-map-slot :global(.mapmyvisitors-logo),
  .visitor-map-slot :global(.mapmyvisitors-bottom-text) {
    display: none !important;
  }
  .visitor-map-slot :global(.mapmyvisitors-visitors),
  .visitor-map-slot :global(.mapmyvisitors-date) {
    font-family: "IBM Plex Mono", monospace !important;
    font-size: 0.62rem !important;
    letter-spacing: 0.04em !important;
    text-shadow: none !important;
  }

  @media (--mobile-sm) {
    .footer-bar {
      /* Keep equal vertical padding so copy sits centered under the top border. */
      padding: 0.75rem 1.25rem;
    }
    .visitor-map-area {
      padding: 0 1.25rem;
    }
  }
</style>
