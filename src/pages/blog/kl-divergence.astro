    padding: 3px 10px;
    border-radius: 6px;
    display: inline-block;
    box-shadow: 0 2px 8px rgba(15, 110, 86, 0.12);
  }
  :global([data-theme="dark"] .token-ctx-current) {
    color: #5DCAA5;
    background: linear-gradient(135deg, #0d2e25, #0f3a2e);
    border-color: #1D6B50;
  }
  :global(.token-ctx-empty) {
    color: var(--text-3);
    font-style: italic;
    font-size: 0.68rem;
  }

  .token-calc-list {
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
  }
  :global(.token-calc-row) {
    display: grid;
    grid-template-columns: 3.5rem 1fr auto;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.72rem;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  :global(.token-calc-row.is-generated) {
    border-color: #5DCAA5;
    background: linear-gradient(90deg, rgba(29, 158, 117, 0.06), var(--surface) 40%);
    box-shadow: inset 3px 0 0 #1D9E75;
  }
  :global([data-theme="dark"] .token-calc-row.is-generated) {
    border-color: #1D6B50;
    background: linear-gradient(90deg, rgba(29, 158, 117, 0.12), var(--surface) 40%);
  }
  :global(.token-calc-name) {
    font-weight: 500;
    color: var(--text);
  }
  :global(.token-calc-math) {
    display: flex;
    flex-direction: column;
    gap: 0.06rem;
    min-width: 0;
  }
  :global(.token-calc-formula) {
    font-size: 0.6rem;
    color: var(--text-2);
    line-height: 1.3;
  }
  :global(.token-calc-evals) {
    font-size: 0.56rem;
    color: var(--text-3);
    line-height: 1.3;
  }
  :global(.token-calc-val) {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.65rem;
    font-weight: 500;
    color: #534AB7;
    white-space: nowrap;
  }
  :global([data-theme="dark"] .token-calc-val) { color: #9B93F0; }
  .token-calc-total {
    font-size: 0.63rem;
    color: var(--text-2);
    padding: 0.4rem 0.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    text-align: center;
    line-height: 1.45;
  }
  .token-calc-total strong {
    color: #0F6E56;
    font-weight: 500;
  }
  :global([data-theme="dark"]) .token-calc-total strong { color: #5DCAA5; }

  .token-compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.4rem;
  }
  .token-model-block {
    border-radius: 8px;
    padding: 0.5rem 0.55rem;
    border: 1px solid var(--border);
  }
  .token-model-p {
    background: linear-gradient(160deg, rgba(127, 119, 221, 0.06), var(--surface));
    border-color: rgba(175, 169, 236, 0.5);
  }
  .token-model-q {
    background: linear-gradient(160deg, rgba(29, 158, 117, 0.06), var(--surface));
    border-color: rgba(93, 202, 165, 0.45);
  }
  .token-model-label {
    font-size: 0.6rem;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 0.35rem;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .token-bar-list {
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
  }

  :global(.token) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 4px 11px 4px 8px;
    border-radius: 7px;
    margin: 2px;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s, border-color 0.2s;
    border: 1px solid rgba(93, 202, 165, 0.45);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.8rem;
    background: var(--bg);
    color: var(--text-2);
  }
  :global(.token-slot) {
    font-size: 0.55rem;
    color: var(--text-3);
    opacity: 0.7;
  }
  :global(.token:hover) {
    border-color: #5DCAA5;
    color: #085041;
    transform: translateY(-1px);
    box-shadow: 0 3px 10px rgba(15, 110, 86, 0.1);
  }
  :global([data-theme="dark"] .token:hover) {
    color: #5DCAA5;
    box-shadow: 0 3px 12px rgba(0,0,0,0.25);
  }
  :global(.token.active) {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 4px 14px rgba(29, 158, 117, 0.22);
    background: linear-gradient(135deg, #1D9E75, #0F6E56);
    color: #fff;
    border-color: #0a5c47;
  }
  :global(.token.active .token-slot) { color: rgba(255,255,255,0.65); }
  :global(.token.context-past) {
    background: linear-gradient(135deg, #EEEDFE, #f5f4fd);
    color: #534AB7;
    border-color: #AFA9EC;
  }
  :global([data-theme="dark"] .token.context-past) {
    background: linear-gradient(135deg, #1d1c35, #252347);
    color: #9B93F0;
    border-color: #3d3870;
  }
  :global(.token.context-future) {
    opacity: 0.42;
    border-style: dashed;
  }

  :global(.hbar-row) {
    display: grid;
    grid-template-columns: 4.25rem 1fr 2.5rem;
    align-items: center;
    gap: 0.5rem;
  }
  :global(.hbar-tok) {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.65rem;
    color: var(--text-2);
    text-align: right;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(.hbar-track) {
    height: 7px;
    background: var(--border-soft);
    border-radius: 4px;
    overflow: hidden;
  }
  :global(.hbar-fill) {
    height: 100%;
    border-radius: 4px;
    width: 0;
    transition: width 0.4s ease;
  }
  :global(.hbar-pct) {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.62rem;
    font-weight: 500;
    text-align: right;
    color: var(--text);
  }

  /* ── Canvas wrap ── */
  .canvas-wrap {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem;
    margin: 1.25rem 0;
  }
  canvas { display: block; width: 100%; }

  /* ── Controls ── */
  .controls {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0.6rem 0;
    flex-wrap: wrap;
  }
  .ctrl-label { font-size: 0.78rem; color: var(--text-2); min-width: 110px; }
  .ctrl-val { font-size: 0.78rem; font-weight: 500; min-width: 38px; color: var(--text); }
  input[type=range] { flex: 1; min-width: 100px; accent-color: #7F77DD; cursor: pointer; }

  /* ── Formula box ── */
  .formula-box {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem;
    text-align: center;
    margin: 1.25rem 0;
  }
  .formula { font-size: 1.05rem; color: var(--text); }
  .formula-sub { font-size: 0.78rem; color: var(--text-2); margin-top: 0.5rem; }
  .formula-box-compact {
    padding: 0.85rem 1rem;
    margin: 0.5rem 0 0.65rem;
  }
  .formula-box-compact .formula { font-size: 0.95rem; }
  .formula-box-compact .formula-sub { font-size: 0.72rem; margin-top: 0.35rem; }

  /* ── Direction compare (s4) ── */
  .dir-setup {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.55rem;
    margin: 0.45rem 0 0.55rem;
    padding: 0.5rem 0.65rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .dir-model {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
    min-width: 0;
    padding: 0.4rem 0.55rem;
    border-radius: 6px;
    border: 1px solid var(--border);
  }
  .dir-model-frozen {
    background: #EEEDFE;
    border-color: #AFA9EC;
  }
  .dir-model-train {
    background: #E1F5EE;
    border-color: #5DCAA5;
  }
  :global([data-theme="dark"]) .dir-model-frozen {
    background: #1d1c35;
    border-color: #3d3870;
  }
  :global([data-theme="dark"]) .dir-model-train {
    background: #0d2e25;
    border-color: #1D6B50;
  }
  .dir-badge {
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 3px 7px;
    border-radius: 4px;
    flex-shrink: 0;
  }
  .dir-badge-frozen {
    background: #534AB7;
    color: #fff;
  }
  .dir-badge-train {
    background: #0F6E56;
    color: #fff;
  }
  .dir-model-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .dir-model-inline {
    font-size: 0.68rem;
    color: var(--text-2);
    line-height: 1.35;
    min-width: 0;
  }
  .dir-model-inline strong {
    font-weight: 500;
    color: var(--text);
  }
  .dir-model-name {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text);
  }
  .dir-model-sub {
    font-size: 0.68rem;
    color: var(--text-2);
    line-height: 1.35;
  }
  .dir-arrow {
    flex-shrink: 0;
    font-size: 0.6rem;
    color: var(--text-3);
    letter-spacing: 0.02em;
    white-space: nowrap;
    padding: 0 0.15rem;
  }
  .dir-compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 0.35rem;
  }
  .dir-card {
    border-radius: 8px;
    padding: 0.75rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .dir-card-forward {
    background: #EEEDFE;
    border: 1px solid #AFA9EC;
  }
  .dir-card-reverse {
    background: #E1F5EE;
    border: 1px solid #5DCAA5;
  }
  :global([data-theme="dark"]) .dir-card-forward {
    background: #1d1c35;
    border-color: #3d3870;
  }
  :global([data-theme="dark"]) .dir-card-reverse {
    background: #0d2e25;
    border-color: #1D6B50;
  }
  .dir-card h4 {
    font-size: 0.82rem;
    font-weight: 600;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .dir-card-forward h4 { color: #3C3489; }
  .dir-card-reverse h4 { color: #085041; }
  :global([data-theme="dark"]) .dir-card-forward h4 { color: #9B93F0; }
  :global([data-theme="dark"]) .dir-card-reverse h4 { color: #5DCAA5; }
  .dir-formula {
    font-size: 0.72rem;
    color: var(--text);
    padding: 0.4rem 0.5rem;
    background: rgba(255,255,255,0.45);
    border-radius: 5px;
    text-align: center;
  }
  :global([data-theme="dark"]) .dir-formula {
    background: rgba(0,0,0,0.2);
  }
  .dir-points {
    margin: 0;
    padding: 0 0 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.72rem;
    color: var(--text-2);
    line-height: 1.45;
  }
  .dir-points strong { color: var(--text); font-weight: 500; }
  .dir-card-forward .dir-points { color: #534AB7; }
  .dir-card-reverse .dir-points { color: #0F6E56; }
  :global([data-theme="dark"]) .dir-card-forward .dir-points { color: #8880d8; }
  :global([data-theme="dark"]) .dir-card-reverse .dir-points { color: #3aaa88; }
  .dir-card-forward .dir-points strong { color: #3C3489; }
  .dir-card-reverse .dir-points strong { color: #085041; }
  :global([data-theme="dark"]) .dir-card-forward .dir-points strong { color: #9B93F0; }
  :global([data-theme="dark"]) .dir-card-reverse .dir-points strong { color: #5DCAA5; }

  /* ── Direction animation (s4) ── */
  .dir-viz {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.65rem 0.75rem 0.55rem;
    margin: 0.55rem 0 0.65rem;
  }
  .dir-viz-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }
  .dir-viz-col-label {
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-align: center;
    color: var(--text-3);
  }
  .dir-viz-col-label:first-child { color: #534AB7; }
  .dir-viz-col-label:last-child { color: #0F6E56; }
  :global([data-theme="dark"]) .dir-viz-col-label:first-child { color: #9B93F0; }
  :global([data-theme="dark"]) .dir-viz-col-label:last-child { color: #5DCAA5; }
  #dirAnimCanvas {
    display: block;
    width: 100%;
    border-radius: 6px;
    background: var(--bg);
  }
  .dir-viz-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    margin-top: 0.45rem;
    flex-wrap: wrap;
  }
  .dir-viz-step {
    font-size: 0.66rem;
    color: var(--text-2);
  }
  .dir-viz-replay {
    padding: 0.35rem 0.7rem;
    border-radius: 5px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text-2);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.64rem;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .dir-viz-replay:hover {
    border-color: #AFA9EC;
    color: #534AB7;
    background: #EEEDFE;
  }
  :global([data-theme="dark"]) .dir-viz-replay:hover {
    background: #1d1c35;
    color: #9B93F0;
    border-color: #3d3870;
  }
  .dir-viz-legend {
    font-size: 0.62rem;
    color: var(--text-3);
    margin: 0.4rem 0 0;
    text-align: center;
    line-height: 1.4;
  }
  #s4 .dir-compare { margin-top: 0.35rem; }
  #s4 p { margin-bottom: 0.45rem; }
  #s4 .dir-setup { margin-bottom: 0.45rem; }

  /* ── KL question section (s5) ── */
  .kl-question-compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem;
    margin: 0.5rem 0 0.65rem;
  }
  .kl-question-card {
    border-radius: 8px;
    padding: 0.75rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .kl-question-forward {
    background: #EEEDFE;
    border: 1px solid #AFA9EC;
  }
  .kl-question-reverse {
    background: #E1F5EE;
    border: 1px solid #5DCAA5;
  }
  :global([data-theme="dark"]) .kl-question-forward {
    background: #1d1c35;
    border-color: #3d3870;
  }
  :global([data-theme="dark"]) .kl-question-reverse {
    background: #0d2e25;
    border-color: #1D6B50;
  }
  .kl-question-card h4 {
    font-size: 0.8rem;
    font-weight: 600;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .kl-question-forward h4 { color: #3C3489; }
  .kl-question-reverse h4 { color: #085041; }
  :global([data-theme="dark"]) .kl-question-forward h4 { color: #9B93F0; }
  :global([data-theme="dark"]) .kl-question-reverse h4 { color: #5DCAA5; }
  .kl-question-main {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.45;
    margin: 0;
    font-style: italic;
    font-family: "Lora", serif;
  }
  .kl-question-main strong { font-style: normal; font-weight: 500; }
  .kl-question-sub {
    font-size: 0.68rem;
    color: var(--text-2);
    line-height: 1.45;
    margin: 0;
  }
  .kl-question-forward .kl-question-sub { color: #534AB7; }
  .kl-question-reverse .kl-question-sub { color: #0F6E56; }
  :global([data-theme="dark"]) .kl-question-forward .kl-question-sub { color: #8880d8; }
  :global([data-theme="dark"]) .kl-question-reverse .kl-question-sub { color: #3aaa88; }

  .kl-rlhf-box {
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid #0F6E56;
    border-radius: 0 8px 8px 0;
    padding: 0.75rem 0.9rem;
  }
  .kl-rlhf-header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
    margin-bottom: 0.45rem;
  }
  .kl-rlhf-badge {
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 4px;
    background: #0F6E56;
    color: #fff;
    flex-shrink: 0;
  }
  .kl-rlhf-header h3 {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text);
    margin: 0;
  }
  .kl-rlhf-points {
    margin: 0;
    padding: 0 0 0 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.74rem;
    color: var(--text-2);
    line-height: 1.45;
  }
  .kl-rlhf-points strong { color: var(--text); font-weight: 500; }
  .kl-rlhf-points .mono {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.7rem;
    color: #085041;
  }
  :global([data-theme="dark"]) .kl-rlhf-points .mono { color: #5DCAA5; }
  #s5 p { margin-bottom: 0.45rem; }

  @media (max-width: 820px) {
    .dir-setup {
      flex-wrap: wrap;
      gap: 0.4rem;
    }
    .dir-arrow {
      width: 100%;
      text-align: center;
      padding: 0;
    }
    .dir-model { flex: 1 1 calc(50% - 0.5rem); }
    .kl-question-compare { grid-template-columns: 1fr; }
  }

  /* ── Props list ── */
  .props-list { display: flex; flex-direction: column; gap: 0.6rem; margin: 0.75rem 0; }
  .prop-item { display: flex; gap: 0.75rem; align-items: flex-start; font-size: 0.925rem; color: var(--text-2); }
  .prop-item strong { color: var(--text); font-weight: 500; }
  .prop-num { color: #7F77DD; font-size: 0.875rem; flex-shrink: 0; padding-top: 0.05rem; }

  /* ── Table ── */
  .table-wrap {
    overflow-x: auto;
    margin: 1.25rem 0;
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  table { width: 100%; border-collapse: collapse; font-size: 0.825rem; }
  th {
    text-align: left;
    padding: 6px 10px;
    font-weight: 500;
    font-size: 0.75rem;
    color: var(--text-2);
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  td { padding: 6px 10px; border-bottom: 1px solid var(--border-soft); color: var(--text); }
  .td-num { font-family: "IBM Plex Mono", monospace; font-size: 0.78rem; }
  .td-hi { font-weight: 500; color: #534AB7; }
  tr.total-row td {
    font-weight: 500;
    border-top: 1px solid var(--border);
    border-bottom: none;
    padding-top: 12px;
    background: var(--surface);
  }
  :global([data-theme="dark"]) .td-hi { color: #9B93F0; }

  /* ── KL result ── */
  .kl-result {
    text-align: center;
    padding: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    margin: 0.75rem 0;
  }
  .kl-result-compact {
    padding: 0.75rem;
    margin: 0.5rem 0;
  }
  .kl-result-compact .kl-big { font-size: 2rem; }
  .kl-big { font-size: 2.5rem; font-weight: 500; color: #534AB7; }
  .kl-label { font-size: 0.78rem; color: var(--text-2); margin-top: 4px; }
  :global([data-theme="dark"]) .kl-big { color: #9B93F0; }

  /* ── PPO box ── */
  .ppo-box {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem 1.1rem;
    margin: 0.65rem 0 0;
  }
  .ppo-stack {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.45rem;
    margin-bottom: 0.85rem;
    max-width: 22rem;
    margin-left: auto;
    margin-right: auto;
  }
  .ppo-arrow-down {
    text-align: center;
    font-size: 0.75rem;
    color: var(--text-3);
    letter-spacing: 0.04em;
  }
  .model-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.75rem 0.9rem;
    text-align: center;
  }
  .model-card-source {
    border-color: #AFA9EC;
    background: #EEEDFE;
  }
  .model-card-student {
    border-color: #5DCAA5;
    background: #E1F5EE;
  }
  :global([data-theme="dark"]) .model-card-source {
    background: #1d1c35;
    border-color: #3d3870;
  }
  :global([data-theme="dark"]) .model-card-student {
    background: #0d2e25;
    border-color: #1D6B50;
  }
  .model-name { font-size: 0.82rem; font-weight: 500; color: var(--text); }
  .model-card-source .model-name { color: #3C3489; }
