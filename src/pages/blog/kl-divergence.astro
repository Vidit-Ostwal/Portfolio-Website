<script>
const CANVAS_H = 155;

function fmtCalcProb(v) {
  return v.toFixed(2);
}

function fmtCalcContrib(v) {
  const s = Math.abs(v).toFixed(3);
  return (v >= 0 ? '+' : '−') + s;
}

function fmtCalcSum(contribs) {
  return contribs.map((c, i) => {
    if (c == null) return '—';
    if (i === 0) return fmtCalcContrib(c);
    return (c >= 0 ? ' + ' : ' − ') + Math.abs(c).toFixed(3);
  }).join('');
}

/* ─────────── Token data ─────────── */
let selectedTokenIndex = -1;

const tokenData = [
  { text: "The", parent: [{t:"The",p:0.72},{t:"A",p:0.15},{t:"Paris",p:0.08},{t:"France",p:0.05}], student: [{t:"The",p:0.68},{t:"A",p:0.18},{t:"Paris",p:0.10},{t:"France",p:0.04}] },
  { text: "capital", parent: [{t:"capital",p:0.65},{t:"city",p:0.20},{t:"heart",p:0.10},{t:"answer",p:0.05}], student: [{t:"capital",p:0.70},{t:"city",p:0.18},{t:"heart",p:0.08},{t:"answer",p:0.04}] },
  { text: "of", parent: [{t:"of",p:0.88},{t:"city",p:0.07},{t:"in",p:0.03},{t:"for",p:0.02}], student: [{t:"of",p:0.90},{t:"city",p:0.05},{t:"in",p:0.03},{t:"for",p:0.02}] },
  { text: "France", parent: [{t:"France",p:0.80},{t:"Paris",p:0.10},{t:"Europe",p:0.07},{t:"the",p:0.03}], student: [{t:"France",p:0.75},{t:"Paris",p:0.14},{t:"Europe",p:0.08},{t:"the",p:0.03}] },
  { text: "is", parent: [{t:"is",p:0.82},{t:"was",p:0.10},{t:"has",p:0.05},{t:"remains",p:0.03}], student: [{t:"is",p:0.79},{t:"was",p:0.12},{t:"has",p:0.06},{t:"remains",p:0.03}] },
  { text: "Paris", parent: [{t:"Paris",p:0.91},{t:"Lyon",p:0.04},{t:"Marseille",p:0.03},{t:"Nice",p:0.02}], student: [{t:"Paris",p:0.95},{t:"Lyon",p:0.02},{t:"Marseille",p:0.02},{t:"Nice",p:0.01}] },
];

function computeTokenReverseKL(parent, student, generatedText) {
  const pmap = Object.fromEntries(parent.map(x => [x.t, x.p]));
  let kl = 0;
  const contribs = [];
  const rows = student.map(s => {
    const q = s.p;
    const p = pmap[s.t] ?? 0;
    const isGenerated = s.t === generatedText;
    if (q < 0.001 || p < 0.001) {
      contribs.push(null);
      const pStr = fmtCalcProb(p);
      const qStr = fmtCalcProb(q);
      return {
        html: `<div class="token-calc-hero">
          <span class="token-calc-word">${s.t}</span>
          <span class="token-calc-formula mono">${qStr} × log(${qStr}/${pStr}) ≈ 0</span>
        </div>`,
        sample: null,
        isGenerated,
      };
    }
    const logRatio = Math.log(q / p);
    const contrib = q * logRatio;
    kl += contrib;
    contribs.push(contrib);
    const pStr = fmtCalcProb(p);
    const qStr = fmtCalcProb(q);
    const contribStr = fmtCalcContrib(contrib);
    return {
      html: `<div class="token-calc-hero">
        <span class="token-calc-word">${s.t}</span>
        <span class="token-calc-formula mono">${qStr} × log(${qStr}/${pStr}) = ${contribStr}</span>
      </div>`,
      sample: isGenerated ? contrib : null,
      isGenerated,
    };
  });
  const sampleKL = rows.find(r => r.isGenerated)?.sample;
  return { kl: Math.max(0, kl), contribs, rows, sampleKL };
}

function getTokenInsight(d, kl) {
  const gen = d.text;
  const pGen = d.parent.find(x => x.t === gen)?.p ?? 0;
  const qGen = d.student.find(x => x.t === gen)?.p ?? 0;
  const delta = qGen - pGen;
  if (kl < 0.008) {
    return `Q and P agree on "${gen}" — almost no drift at this step.`;
  }
  if (delta > 0.04) {
    return `Q is more confident than P on "${gen}" — that extra mass is what reverse KL penalizes.`;
  }
  if (delta < -0.04) {
    return `Q is less sure than P about "${gen}" — still a mismatch, but the penalty stays small here.`;
  }
  return `Q's next-token guess differs slightly from P on "${gen}" — modest KL penalty.`;
}

function renderTokenContext(i) {
  const el = document.getElementById('tokenContext');
  if (!el) return;
  const prefix = tokenData.slice(0, i).map(t => t.text).join(' · ');
  const suffix = tokenData.slice(i + 1).map(t => t.text).join(' · ');
  const current = tokenData[i].text;

  el.innerHTML = `<div class="token-ctx-simple">
    <div class="token-ctx-row">
      <span class="token-ctx-kicker">Already written</span>
      <span class="token-ctx-val">${prefix || '—'}</span>
    </div>
    <div class="token-ctx-row token-ctx-row-now">
      <span class="token-ctx-kicker">Predicting now</span>
      <span class="token-ctx-now">${current}</span>
    </div>
    <div class="token-ctx-row">
      <span class="token-ctx-kicker">Still to come</span>
      <span class="token-ctx-val">${suffix || '—'}</span>
    </div>
  </div>`;
}

function renderTokenDots() {
  const el = document.getElementById('tokenDots');
  if (!el) return;
  el.innerHTML = tokenData.map((_, i) =>
    `<button type="button" class="token-dot" data-token-dot="${i}" aria-label="Token ${i + 1}"></button>`
  ).join('');
  el.querySelectorAll('.token-dot').forEach(btn => {
    btn.addEventListener('click', () => selectToken(+btn.dataset.tokenDot));
  });
}

function updateTokenNav(i) {
  const prev = document.getElementById('tokenPrev');
  const next = document.getElementById('tokenNext');
  const indicator = document.getElementById('tokenStepIndicator');
  if (prev) prev.disabled = i <= 0;
  if (next) next.disabled = i >= tokenData.length - 1;
  if (indicator) indicator.textContent = `${i + 1} / ${tokenData.length}`;
  document.querySelectorAll('.token-dot').forEach((dot, idx) => {
    dot.classList.toggle('active', idx === i);
  });
}

function updateTokenHighlight(i) {
  document.querySelectorAll('.token').forEach((tok, idx) => {
    tok.classList.remove('active', 'context-past', 'context-future');
    if (idx === i) tok.classList.add('active');
    else if (idx < i) tok.classList.add('context-past');
    else tok.classList.add('context-future');
  });
}

/* ─────────── Render token sentence ─────────── */
function renderTokenSentence() {
  const el = document.getElementById('tokenSentence');
  if (!el) return;
  el.innerHTML = tokenData.map((t, i) =>
    `<span class="token" data-token-index="${i}" role="button" tabindex="0">
      <span class="token-slot">${String(i + 1).padStart(2, '0')}</span>${t.text}
    </span>`
  ).join(' ');
}

function selectToken(i) {
  if (i < 0 || i >= tokenData.length) return;
  selectedTokenIndex = i;
  const d = tokenData[i];
  updateTokenHighlight(i);
  updateTokenNav(i);

  const title = document.getElementById('tokenTitle');
  if (title) title.textContent = d.text;

  renderTokenContext(i);

  const { kl, rows } = computeTokenReverseKL(d.parent, d.student, d.text);
  const genRow = rows.find(r => r.isGenerated);
  const calcHighlight = document.getElementById('tokenCalcHighlight');
  if (calcHighlight) calcHighlight.innerHTML = genRow?.html ?? '';
  const calcTotal = document.getElementById('tokenCalcTotal');
  if (calcTotal) {
    calcTotal.innerHTML = `Total KL(Q∥P) = <strong>${kl.toFixed(4)}</strong> nats · top candidates at this step`;
  }

  const klEl = document.getElementById('tokenKL');
  if (klEl) klEl.textContent = kl.toFixed(4);

  const insight = document.getElementById('tokenInsight');
  if (insight) insight.textContent = getTokenInsight(d, kl);

  renderTokenBars('parentBars', d.parent, '#7F77DD', d.text);
  renderTokenBars('studentBars', d.student, '#1D9E75', d.text);
}

function stepToken(delta) {
  if (selectedTokenIndex < 0) {
    selectToken(delta > 0 ? 0 : tokenData.length - 1);
    return;
  }
  selectToken(Math.max(0, Math.min(tokenData.length - 1, selectedTokenIndex + delta)));
}

function renderTokenBars(elId, data, color, highlightTok) {
  const el = document.getElementById(elId);
  if (!el) return;
  el.innerHTML = data.map(d => {
    const pct = Math.round(d.p * 100);
    const isPick = highlightTok && d.t === highlightTok;
    return `<div class="hbar-row${isPick ? ' is-pick' : ''}">
      <span class="hbar-tok">${d.t}${isPick ? ' ✓' : ''}</span>
      <div class="hbar-track">
        <div class="hbar-fill" data-width="${pct}" style="background:${color};opacity:${isPick ? 1 : 0.88}"></div>
      </div>
      <span class="hbar-pct" style="color:${color}">${pct}%</span>
    </div>`;
  }).join('');

  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      el.querySelectorAll('.hbar-fill').forEach(bar => {
        bar.style.width = `${bar.dataset.width}%`;
      });
    });
  });
}

function renderBars(elId, data, color, maxBarH = 58) {
  const el = document.getElementById(elId);
  if (!el) return;
  const maxP = Math.max(...data.map(d => d.p));
  el.innerHTML = data.map(d => {
    const targetH = Math.round((d.p / maxP) * maxBarH);
    return `<div class="bar-col">
      <div class="bar-pct" style="color:${color}">${Math.round(d.p * 100)}%</div>
      <div class="bar-track">
        <div class="bar-fill" data-target="${targetH}" style="height:0;background:${color};opacity:0.82"></div>
      </div>
      <div class="bar-tok">${d.t}</div>
    </div>`;
  }).join('');

  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      el.querySelectorAll('.bar-fill').forEach(bar => {
        bar.style.height = `${bar.dataset.target}px`;
      });
    });
  });
}

/* ─────────── Dark mode helper ─────────── */
function isDark() {
  return document.documentElement.getAttribute('data-theme') === 'dark';
}

/* ─────────── Gaussian ─────────── */
function gaussian(x, mu, sigma) {
  return Math.exp(-0.5 * Math.pow((x - mu) / sigma, 2));
}

/* ─────────── Draw two distributions ─────────── */
function drawDists(canvasId, muP, muQ, sigP, sigQ, colorP, colorQ) {
  const canvas = document.getElementById(canvasId);
  if (!canvas) return;
  const dpr = window.devicePixelRatio || 1;
  const W = canvas.parentElement.clientWidth - 32;
  const baseY = CANVAS_H - 32;
  const plotH = CANVAS_H - 55;
  canvas.width = W * dpr;
  canvas.height = CANVAS_H * dpr;
  canvas.style.width = W + 'px';
  canvas.style.height = CANVAS_H + 'px';
  const ctx = canvas.getContext('2d');
  ctx.scale(dpr, dpr);
  ctx.clearRect(0, 0, W, CANVAS_H);

  const gridColor = isDark() ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)';

  for (let gx = 0; gx <= W; gx += W / 5) {
    ctx.beginPath(); ctx.strokeStyle = gridColor; ctx.lineWidth = 0.5;
    ctx.moveTo(gx, 0); ctx.lineTo(gx, CANVAS_H - 20); ctx.stroke();
  }

  function drawCurve(mu, sig, color, alpha) {
    ctx.beginPath();
    for (let px = 0; px <= W; px++) {
      const t = px / W;
      const y = gaussian(t, mu / 100, sig);
      const sy = baseY - y * plotH;
      px === 0 ? ctx.moveTo(px, sy) : ctx.lineTo(px, sy);
    }
    ctx.strokeStyle = color; ctx.lineWidth = 2.5; ctx.stroke();
    ctx.lineTo(W, baseY); ctx.lineTo(0, baseY); ctx.closePath();
    ctx.fillStyle = color + Math.round(alpha * 255).toString(16).padStart(2, '0');
    ctx.fill();
  }

  drawCurve(muP, sigP, colorP, 0.18);
  drawCurve(muQ, sigQ, colorQ, 0.14);

  ctx.font = `500 11px "IBM Plex Mono", monospace`;
  ctx.fillStyle = colorP; ctx.fillText('P (true distribution)', 10, 16);
  ctx.fillStyle = colorQ; ctx.fillText('Q (approximation)', 10, 30);
}

function updateMainDist() {
  const pv = +document.getElementById('pPeak').value;
  const qv = +document.getElementById('qPeak').value;
  document.getElementById('pPeakVal').textContent = pv + '%';
  document.getElementById('qPeakVal').textContent = qv + '%';
  drawDists('distCanvas', pv, qv, 0.14, 0.14, '#7F77DD', '#1D9E75');
}

/* ─────────── KL live calculator ─────────── */
const CALC_OUTCOMES = ['Rain', 'Sunny', 'Cloudy'];
const CALC_SEG_CLASS = { Rain: 'rain', Sunny: 'sunny', Cloudy: 'cloudy' };
let calcP = [0.5, 0.3, 0.2];
let calcQ = [0.2, 0.5, 0.3];

function randomDist() {
  const raw = CALC_OUTCOMES.map(() => 0.05 + Math.random() * 0.9);
  const sum = raw.reduce((a, b) => a + b, 0);
  return raw.map(v => v / sum);
}

function shuffleCalc() {
  calcP = randomDist();
  calcQ = randomDist();
  computeKL();
}

function getCalcOutcomes() {
  return CALC_OUTCOMES.map((name, i) => ({ name, p: calcP[i], q: calcQ[i] }));
}

function renderCalcStacks(outcomes) {
  const el = document.getElementById('calcStacks');
  if (!el) return;

  const renderStack = (label, key, subtitle) => {
    const segs = outcomes.map(o => {
      const pct = Math.round(o[key] * 100);
      const cls = CALC_SEG_CLASS[o.name] || '';
      const labelInside = pct >= 14 ? `${pct}%` : '';
      return `<div class="calc-seg ${cls}" style="width:${pct}%">${labelInside}</div>`;
    }).join('');
    const legend = outcomes.map(o => `${o.name} ${Math.round(o[key] * 100)}%`).join(' · ');
    return `<div class="calc-stack-row">
      <span class="calc-stack-label">${label}</span>
      <div class="calc-stack-wrap">
        <span class="calc-stack-sub">${subtitle}</span>
        <div class="calc-stack">${segs}</div>
        <div class="calc-stack-legend">${legend}</div>
      </div>
    </div>`;
  };

  el.innerHTML = renderStack('P', 'p', 'truth') + renderStack('Q', 'q', 'forecast');
}

function computeKL() {
  const outcomes = getCalcOutcomes();
  renderCalcStacks(outcomes);

  let kl = 0;
  const contribs = [];
  const rows = outcomes.map(o => {
    const pStr = fmtCalcProb(o.p);
    const qStr = fmtCalcProb(o.q);
    if (o.p < 0.001 || o.q < 0.001) {
      contribs.push(null);
      return `<div class="calc-penalty-row">
        <span class="calc-penalty-name">${o.name}</span>
        <div class="calc-penalty-math mono">
          <span class="calc-penalty-formula">${pStr} × log(${pStr} / ${qStr})</span>
          <span class="calc-penalty-evals">both P and Q must be &gt; 0</span>
        </div>
        <span class="calc-penalty-val">—</span>
      </div>`;
    }
    const logRatio = Math.log(o.p / o.q);
    const contrib = o.p * logRatio;
    kl += contrib;
    contribs.push(contrib);
    const logStr = logRatio.toFixed(3);
    const contribStr = fmtCalcContrib(contrib);
    return `<div class="calc-penalty-row">
      <span class="calc-penalty-name">${o.name}</span>
      <div class="calc-penalty-math mono">
        <span class="calc-penalty-formula">${pStr} × log(${pStr} / ${qStr})</span>
        <span class="calc-penalty-evals">= ${pStr} × ${logStr} = ${contribStr}</span>
      </div>
      <span class="calc-penalty-val">${contribStr}</span>
    </div>`;
  });

  const breakdown = document.getElementById('klBreakdown');
  if (breakdown) breakdown.innerHTML = rows.join('');

  const total = Math.max(0, kl);
  const equation = document.getElementById('klEquation');
  if (equation) {
    const parts = contribs.map(c => c == null ? '—' : fmtCalcContrib(c));
    equation.innerHTML = parts.every(p => p !== '—')
      ? `${fmtCalcSum(contribs)} = <strong>${total.toFixed(3)}</strong> nats`
      : `Align P and Q on every outcome → penalty drops to <strong>0</strong>`;
  }

  const klRes = document.getElementById('klResult');
  if (klRes) klRes.textContent = total.toFixed(3);
}

/* ─────────── Direction training animation (s4) ─────────── */
const DIR_CANVAS_H = 128;
const DIR_ANIM_STEPS = 48;
const DIR_ANIM_MS = 2400;

let dirAnimProgress = 0;
let dirAnimFrame = null;
let dirAnimStart = 0;
let dirAnimVisible = false;

function bimodalP(x) {
  return 0.5 * gaussian(x, 0.25, 0.09) + 0.5 * gaussian(x, 0.72, 0.09);
}

function easeTrain(t) {
  return 1 - Math.pow(1 - t, 2.4);
}

function qForwardAt(x, e) {
  const mu = 0.5 + (0.48 - 0.5) * e;
  const sig = 0.16 + (0.24 - 0.16) * e;
  const amp = 1 + (0.58 - 1) * e;
  return amp * gaussian(x, mu, sig);
}

function qReverseAt(x, e) {
  const mu = 0.5 + (0.26 - 0.5) * e;
  const sig = 0.16 + (0.075 - 0.16) * e;
  return gaussian(x, mu, sig);
}

function drawDirCurve(ctx, x0, panelW, baseY, plotH, fn, color, fillAlpha) {
  const vals = [];
  for (let px = 0; px <= panelW; px++) vals.push(fn(px / panelW));
  const mx = Math.max(...vals, 0.001);
  ctx.beginPath();
  vals.forEach((v, px) => {
    const sy = baseY - (v / mx) * plotH;
    px === 0 ? ctx.moveTo(x0 + px, sy) : ctx.lineTo(x0 + px, sy);
  });
  ctx.strokeStyle = color;
  ctx.lineWidth = 2.2;
  ctx.stroke();
  ctx.lineTo(x0 + panelW, baseY);
  ctx.lineTo(x0, baseY);
  ctx.closePath();
  ctx.fillStyle = color + Math.round(fillAlpha * 255).toString(16).padStart(2, '0');
  ctx.fill();
}

function drawDirAnim(progress) {
  const canvas = document.getElementById('dirAnimCanvas');
  if (!canvas) return;
  const dpr = window.devicePixelRatio || 1;
  const wrap = canvas.parentElement;
  const W = Math.max(280, wrap.clientWidth - 24);
  const baseY = DIR_CANVAS_H - 28;
  const plotH = DIR_CANVAS_H - 44;
  canvas.width = W * dpr;
  canvas.height = DIR_CANVAS_H * dpr;
  canvas.style.width = W + 'px';
  canvas.style.height = DIR_CANVAS_H + 'px';
  const ctx = canvas.getContext('2d');
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.clearRect(0, 0, W, DIR_CANVAS_H);

  const gap = 10;
  const panelW = (W - gap) / 2;
  const e = easeTrain(progress);
  const gridColor = isDark() ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)';

  [0, panelW + gap].forEach((x0, i) => {
    ctx.save();
    ctx.beginPath();
    ctx.rect(x0, 18, panelW, DIR_CANVAS_H - 18);
    ctx.clip();
    for (let gx = x0; gx <= x0 + panelW; gx += panelW / 4) {
      ctx.beginPath();
      ctx.strokeStyle = gridColor;
      ctx.lineWidth = 0.5;
      ctx.moveTo(gx, 22);
      ctx.lineTo(gx, baseY);
      ctx.stroke();
    }
    drawDirCurve(ctx, x0, panelW, baseY, plotH, bimodalP, '#7F77DD', 0.2);
    const qFn = i === 0
      ? x => qForwardAt(x, e)
      : x => qReverseAt(x, e);
    drawDirCurve(ctx, x0, panelW, baseY, plotH, qFn, '#1D9E75', 0.2);
    ctx.restore();
  });

  ctx.setLineDash([4, 4]);
  ctx.strokeStyle = isDark() ? 'rgba(255,255,255,0.12)' : 'rgba(0,0,0,0.1)';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(panelW + gap / 2, 16);
  ctx.lineTo(panelW + gap / 2, DIR_CANVAS_H - 6);
  ctx.stroke();
  ctx.setLineDash([]);

  ctx.font = '500 10px "IBM Plex Mono", monospace';
  ctx.fillStyle = '#7F77DD';
  ctx.fillText('P frozen', 8, 12);
  ctx.fillStyle = '#1D9E75';
  ctx.fillText('Q training', 72, 12);

  const step = Math.round(progress * DIR_ANIM_STEPS);
  const stepEl = document.getElementById('dirAnimStep');
  if (stepEl) stepEl.textContent = `Step ${step} / ${DIR_ANIM_STEPS}`;

  const explain = document.getElementById('dirAnimExplain');
  if (explain) {
    if (progress < 0.08) {
      explain.textContent = 'Both Q models start identical. P (purple) stays fixed — only Q (green) moves.';
    } else if (progress < 0.95) {
      explain.textContent = 'Left: forward KL pushes Q to spread across both peaks. Right: reverse KL pulls Q onto one peak.';
    } else {
      explain.textContent = 'Same frozen P, same starting Q — different loss, different final student.';
    }
  }
}

function tickDirAnim(now) {
  if (!dirAnimVisible) return;
  const t = Math.min(1, (now - dirAnimStart) / DIR_ANIM_MS);
  dirAnimProgress = t;
  drawDirAnim(t);
  if (t < 1) {
    dirAnimFrame = requestAnimationFrame(tickDirAnim);
  } else {
    dirAnimFrame = null;
  }
}

function startDirAnim() {
  cancelAnimationFrame(dirAnimFrame);
  dirAnimProgress = 0;
  dirAnimStart = performance.now();
  drawDirAnim(0);
  dirAnimFrame = requestAnimationFrame(tickDirAnim);
}

function initDirAnim() {
  const canvas = document.getElementById('dirAnimCanvas');
  const section = document.getElementById('s4');
  if (!canvas || !section) return;

  document.getElementById('dirAnimReplay')?.addEventListener('click', startDirAnim);

  const observer = new IntersectionObserver((entries) => {
    const visible = entries[0]?.isIntersecting;
    if (visible && !dirAnimVisible) {
      dirAnimVisible = true;
      startDirAnim();
    } else if (!visible) {
      dirAnimVisible = false;
      cancelAnimationFrame(dirAnimFrame);
      dirAnimFrame = null;
    }
  }, { threshold: 0.35 });

  observer.observe(section);
  drawDirAnim(dirAnimProgress);
}

/* ─────────── Section index ─────────── */
const SECTIONS = [
  { id: 's0', label: 'Intro' },
  { id: 's1', label: 'Distributions' },
  { id: 's2', label: 'The Formula' },
  { id: 's3', label: 'Live Calc' },
  { id: 's4', label: 'Which Direction' },
  { id: 's5', label: 'The Question' },
  { id: 's6', label: 'Token by Token' },
  { id: 's7', label: 'Recap' },
];

let activeSectionId = SECTIONS[0].id;
let keyboardNavLock = false;

function buildSectionNav() {
  const list = document.getElementById('sectionIndex');
  if (!list) return;
  list.innerHTML = SECTIONS.map((s, i) =>
    `<li>
      <button type="button" class="section-index-item" data-index="${i}" data-target="${s.id}">
        ${s.label}
      </button>
    </li>`
  ).join('');

  list.querySelectorAll('.section-index-item').forEach(btn => {
    btn.addEventListener('click', () => goToSection(+btn.dataset.index));
  });
}

function getActiveSectionId() {
  const viewportMid = window.innerHeight / 2;
  let best = SECTIONS[0].id;
  let bestDist = Infinity;
  for (const s of SECTIONS) {
    const el = document.getElementById(s.id);
    if (!el) continue;
    const rect = el.getBoundingClientRect();
    const sectionMid = rect.top + rect.height / 2;
    const dist = Math.abs(sectionMid - viewportMid);
    if (dist < bestDist) {
      bestDist = dist;
      best = s.id;
    }
  }
  return best;
}

function goToSection(index) {
  const clamped = Math.max(0, Math.min(SECTIONS.length - 1, index));
  const el = document.getElementById(SECTIONS[clamped].id);
  if (!el) return;
  keyboardNavLock = true;
  activeSectionId = SECTIONS[clamped].id;
  updateSectionNav();
  el.scrollIntoView({ behavior: 'smooth' });
  window.setTimeout(() => { keyboardNavLock = false; }, 500);
}

function updateSectionNav() {
  if (!keyboardNavLock) activeSectionId = getActiveSectionId();

  const activeIndex = SECTIONS.findIndex(s => s.id === activeSectionId);
  document.querySelectorAll('.section-index-item').forEach((item, i) => {
    item.classList.toggle('active', i === activeIndex);
  });
}

function initSectionNav() {
  buildSectionNav();
  updateSectionNav();
  window.addEventListener('scroll', updateSectionNav, { passive: true });
  window.addEventListener('resize', updateSectionNav, { passive: true });

  window.addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
    if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement || e.target instanceof HTMLSelectElement) return;

    e.preventDefault();
    const current = SECTIONS.findIndex(s => s.id === activeSectionId);
    goToSection(e.key === 'ArrowDown' ? current + 1 : current - 1);
  });
}

/* ─────────── Progress bar ─────────── */
function initProgress() {
  const bar = document.getElementById('read-progress');
  if (!bar) return;
  window.addEventListener('scroll', () => {
    const doc = document.documentElement;
    const scrolled = doc.scrollTop / (doc.scrollHeight - doc.clientHeight);
    bar.style.width = (scrolled * 100).toFixed(1) + '%';
  }, { passive: true });
}

function initInteractions() {
  document.getElementById('tokenSentence')?.addEventListener('click', (e) => {
    const token = e.target.closest('[data-token-index]');
    if (token) selectToken(+token.dataset.tokenIndex);
  });

  document.getElementById('tokenSentence')?.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    const token = e.target.closest('[data-token-index]');
    if (!token) return;
    e.preventDefault();
    selectToken(+token.dataset.tokenIndex);
  });

  document.getElementById('tokenPrev')?.addEventListener('click', () => stepToken(-1));
  document.getElementById('tokenNext')?.addEventListener('click', () => stepToken(1));

  window.addEventListener('keydown', (e) => {
    if (activeSectionId !== 's6') return;
    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
    if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement || e.target instanceof HTMLSelectElement) return;
    e.preventDefault();
    stepToken(e.key === 'ArrowRight' ? 1 : -1);
  });

  document.getElementById('pPeak')?.addEventListener('input', updateMainDist);
  document.getElementById('qPeak')?.addEventListener('input', updateMainDist);
  document.getElementById('calcRandom')?.addEventListener('click', shuffleCalc);
}

/* ─────────── Init ─────────── */
window.addEventListener('load', () => {
  renderTokenSentence();
  renderTokenDots();
  initInteractions();
  selectToken(0);
  updateMainDist();
  computeKL();
  initSectionNav();
  initProgress();
  initDirAnim();
});

window.addEventListener('resize', () => {
  updateMainDist();
  drawDirAnim(dirAnimProgress);
});
</script>
