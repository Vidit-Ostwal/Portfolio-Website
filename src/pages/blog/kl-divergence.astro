<script>
const CANVAS_H = 155;

/* ─────────── Token data ─────────── */
const tokenData = [
  { text: "The", desc: "A very common starting word. Both models agree strongly here.", parent: [{t:"The",p:0.72},{t:"A",p:0.15},{t:"Paris",p:0.08},{t:"France",p:0.05}], student: [{t:"The",p:0.68},{t:"A",p:0.18},{t:"Paris",p:0.10},{t:"France",p:0.04}], kl: 0.003 },
  { text: "capital", desc: "After 'The', 'capital' is a strong prediction from both models.", parent: [{t:"capital",p:0.65},{t:"city",p:0.20},{t:"heart",p:0.10},{t:"answer",p:0.05}], student: [{t:"capital",p:0.70},{t:"city",p:0.18},{t:"heart",p:0.08},{t:"answer",p:0.04}], kl: 0.002 },
  { text: "of", desc: "Grammatically constrained. Very high agreement.", parent: [{t:"of",p:0.88},{t:"city",p:0.07},{t:"in",p:0.03},{t:"for",p:0.02}], student: [{t:"of",p:0.90},{t:"city",p:0.05},{t:"in",p:0.03},{t:"for",p:0.02}], kl: 0.001 },
  { text: "France", desc: "Key factual token. Both models are confident here.", parent: [{t:"France",p:0.80},{t:"Paris",p:0.10},{t:"Europe",p:0.07},{t:"the",p:0.03}], student: [{t:"France",p:0.75},{t:"Paris",p:0.14},{t:"Europe",p:0.08},{t:"the",p:0.03}], kl: 0.006 },
  { text: "is", desc: "Simple linking verb. Very aligned.", parent: [{t:"is",p:0.82},{t:"was",p:0.10},{t:"has",p:0.05},{t:"remains",p:0.03}], student: [{t:"is",p:0.79},{t:"was",p:0.12},{t:"has",p:0.06},{t:"remains",p:0.03}], kl: 0.002 },
  { text: "Paris", desc: "The answer! Both models very confident. The student sharpens slightly after fine-tuning.", parent: [{t:"Paris",p:0.91},{t:"Lyon",p:0.04},{t:"Marseille",p:0.03},{t:"Nice",p:0.02}], student: [{t:"Paris",p:0.95},{t:"Lyon",p:0.02},{t:"Marseille",p:0.02},{t:"Nice",p:0.01}], kl: 0.008 },
];

/* ─────────── Render token sentence ─────────── */
function renderTokenSentence() {
  const el = document.getElementById('tokenSentence');
  if (!el) return;
  el.innerHTML = tokenData.map((t, i) =>
    `<span class="token" data-token-index="${i}" role="button" tabindex="0">${t.text}</span>`
  ).join(' ');
}

function selectToken(i) {
  document.querySelectorAll('.token').forEach(t => t.classList.remove('active'));
  const tok = document.querySelector(`[data-token-index="${i}"]`);
  if (tok) tok.classList.add('active');
  const d = tokenData[i];
  const detail = document.getElementById('tokenDetail');
  const placeholder = document.getElementById('tokenPlaceholder');
  const body = document.getElementById('tokenDetailBody');
  if (placeholder) placeholder.hidden = true;
  if (body) body.hidden = false;
  if (detail) detail.classList.add('is-populated');
  const title = document.getElementById('tokenTitle');
  if (title) title.textContent = d.text;
  const desc = document.getElementById('tokenDesc');
  if (desc) desc.textContent = d.desc;
  renderTokenBars('parentBars', d.parent, '#7F77DD');
  renderTokenBars('studentBars', d.student, '#1D9E75');
  const kl = document.getElementById('tokenKL');
  if (kl) kl.textContent = d.kl.toFixed(4);
}

function renderTokenBars(elId, data, color) {
  const el = document.getElementById(elId);
  if (!el) return;
  el.innerHTML = data.map(d => {
    const pct = Math.round(d.p * 100);
    return `<div class="hbar-row">
      <span class="hbar-tok">${d.t}</span>
      <div class="hbar-track">
        <div class="hbar-fill" data-width="${pct}" style="background:${color};opacity:0.88"></div>
      </div>
      <span class="hbar-pct" style="color:${color}">${pct}%</span>
    </div>`;
  }).join('');

  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      el.querySelectorAll('.hbar-fill').forEach(bar => {
        bar.style.width = `${bar.dataset.width}%`;
      });
    });
  });
}

function renderBars(elId, data, color, maxBarH = 58) {
  const el = document.getElementById(elId);
  if (!el) return;
  const maxP = Math.max(...data.map(d => d.p));
  el.innerHTML = data.map(d => {
    const targetH = Math.round((d.p / maxP) * maxBarH);
    return `<div class="bar-col">
      <div class="bar-pct" style="color:${color}">${Math.round(d.p * 100)}%</div>
      <div class="bar-track">
        <div class="bar-fill" data-target="${targetH}" style="height:0;background:${color};opacity:0.82"></div>
      </div>
      <div class="bar-tok">${d.t}</div>
    </div>`;
  }).join('');

  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      el.querySelectorAll('.bar-fill').forEach(bar => {
        bar.style.height = `${bar.dataset.target}px`;
      });
    });
  });
}

/* ─────────── Dark mode helper ─────────── */
function isDark() {
  return document.documentElement.getAttribute('data-theme') === 'dark';
}

/* ─────────── Gaussian ─────────── */
function gaussian(x, mu, sigma) {
  return Math.exp(-0.5 * Math.pow((x - mu) / sigma, 2));
}

/* ─────────── Draw two distributions ─────────── */
function drawDists(canvasId, muP, muQ, sigP, sigQ, colorP, colorQ) {
  const canvas = document.getElementById(canvasId);
  if (!canvas) return;
  const dpr = window.devicePixelRatio || 1;
  const W = canvas.parentElement.clientWidth - 32;
  const baseY = CANVAS_H - 32;
  const plotH = CANVAS_H - 55;
  canvas.width = W * dpr;
  canvas.height = CANVAS_H * dpr;
  canvas.style.width = W + 'px';
  canvas.style.height = CANVAS_H + 'px';
  const ctx = canvas.getContext('2d');
  ctx.scale(dpr, dpr);
  ctx.clearRect(0, 0, W, CANVAS_H);

  const gridColor = isDark() ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)';

  for (let gx = 0; gx <= W; gx += W / 5) {
    ctx.beginPath(); ctx.strokeStyle = gridColor; ctx.lineWidth = 0.5;
    ctx.moveTo(gx, 0); ctx.lineTo(gx, CANVAS_H - 20); ctx.stroke();
  }

  function drawCurve(mu, sig, color, alpha) {
    ctx.beginPath();
    for (let px = 0; px <= W; px++) {
      const t = px / W;
      const y = gaussian(t, mu / 100, sig);
      const sy = baseY - y * plotH;
      px === 0 ? ctx.moveTo(px, sy) : ctx.lineTo(px, sy);
    }
    ctx.strokeStyle = color; ctx.lineWidth = 2.5; ctx.stroke();
    ctx.lineTo(W, baseY); ctx.lineTo(0, baseY); ctx.closePath();
    ctx.fillStyle = color + Math.round(alpha * 255).toString(16).padStart(2, '0');
    ctx.fill();
  }

  drawCurve(muP, sigP, colorP, 0.18);
  drawCurve(muQ, sigQ, colorQ, 0.14);

  ctx.font = `500 11px "IBM Plex Mono", monospace`;
  ctx.fillStyle = colorP; ctx.fillText('P (true distribution)', 10, 16);
  ctx.fillStyle = colorQ; ctx.fillText('Q (approximation)', 10, 30);
}

function updateMainDist() {
  const pv = +document.getElementById('pPeak').value;
  const qv = +document.getElementById('qPeak').value;
  document.getElementById('pPeakVal').textContent = pv + '%';
  document.getElementById('qPeakVal').textContent = qv + '%';
  drawDists('distCanvas', pv, qv, 0.14, 0.14, '#7F77DD', '#1D9E75');
}

/* ─────────── KL table calculator ─────────── */
function computeKL() {
  const p0 = +document.getElementById('p0').value / 100;
  const q0 = +document.getElementById('q0').value / 100;
  const split = +document.getElementById('split').value / 100;
  document.getElementById('p0val').textContent = Math.round(p0 * 100) + '%';
  document.getElementById('q0val').textContent = Math.round(q0 * 100) + '%';
  document.getElementById('splitval').textContent = Math.round(split * 100) + '%';

  const remP = 1 - p0, remQ = 1 - q0;
  const outcomes = [
    { name: 'Rain',   p: p0,               q: q0              },
    { name: 'Sunny',  p: remP * split,     q: remQ * split    },
    { name: 'Cloudy', p: remP * (1-split), q: remQ * (1-split) },
  ];

  let kl = 0;
  const cards = outcomes.map(o => {
    const pPct = Math.round(o.p * 100);
    const qPct = Math.round(o.q * 100);
    if (o.p < 0.001 || o.q < 0.001) {
      return `<div class="calc-outcome">
        <div class="calc-outcome-head">
          <span class="calc-outcome-name">${o.name}</span>
          <span class="calc-outcome-contrib">—</span>
        </div>
        <div class="calc-prob-row">
          <span class="calc-prob-label">P</span>
          <div class="hbar-track"><div class="hbar-fill" style="width:${pPct}%;background:#7F77DD;opacity:0.88"></div></div>
          <span class="calc-prob-pct">${pPct}%</span>
        </div>
        <div class="calc-prob-row">
          <span class="calc-prob-label is-q">Q</span>
          <div class="hbar-track"><div class="hbar-fill" style="width:${qPct}%;background:#1D9E75;opacity:0.88"></div></div>
          <span class="calc-prob-pct">${qPct}%</span>
        </div>
        <div class="calc-math"><span>log(P/Q) undefined</span><span>P · log(P/Q) —</span></div>
      </div>`;
    }
    const logr = Math.log(o.p / o.q);
    const contrib = o.p * logr;
    kl += contrib;
    return `<div class="calc-outcome">
      <div class="calc-outcome-head">
        <span class="calc-outcome-name">${o.name}</span>
        <span class="calc-outcome-contrib">${contrib.toFixed(4)}</span>
      </div>
      <div class="calc-prob-row">
        <span class="calc-prob-label">P</span>
        <div class="hbar-track"><div class="hbar-fill" style="width:${pPct}%;background:#7F77DD;opacity:0.88"></div></div>
        <span class="calc-prob-pct">${pPct}%</span>
      </div>
      <div class="calc-prob-row">
        <span class="calc-prob-label is-q">Q</span>
        <div class="hbar-track"><div class="hbar-fill" style="width:${qPct}%;background:#1D9E75;opacity:0.88"></div></div>
        <span class="calc-prob-pct">${qPct}%</span>
      </div>
      <div class="calc-math">
        <span>log(P/Q) = ${logr.toFixed(3)}</span>
        <span>P · log(P/Q) = ${contrib.toFixed(4)}</span>
      </div>
    </div>`;
  });

  const breakdown = document.getElementById('klBreakdown');
  if (breakdown) breakdown.innerHTML = cards.join('');

  const klRes = document.getElementById('klResult');
  if (klRes) klRes.textContent = Math.max(0, kl).toFixed(4);
}

/* ─────────── Reverse KL viz ─────────── */
let klMode = 'forward';
function showKLMode(mode) {
  klMode = mode;
  const canvas = document.getElementById('reverseCanvas');
  if (!canvas) return;
  const dpr = window.devicePixelRatio || 1;
  const W = canvas.parentElement.clientWidth - 32;
  const baseY = CANVAS_H - 37;
  const plotH = CANVAS_H - 52;
  canvas.width = W * dpr;
  canvas.height = CANVAS_H * dpr;
  canvas.style.width = W + 'px';
  canvas.style.height = CANVAS_H + 'px';
  const ctx = canvas.getContext('2d');
  ctx.scale(dpr, dpr);
  ctx.clearRect(0, 0, W, CANVAS_H);

  function bimodal(x) {
    return 0.5 * gaussian(x, 0.25, 0.09) + 0.5 * gaussian(x, 0.72, 0.09);
  }
  function drawFn(fn, color, alpha) {
    let vals = [];
    for (let px = 0; px <= W; px++) vals.push(fn(px / W));
    const mx = Math.max(...vals);
    ctx.beginPath();
    vals.forEach((v, px) => {
      const sy = baseY - (v / mx) * plotH;
      px === 0 ? ctx.moveTo(px, sy) : ctx.lineTo(px, sy);
    });
    ctx.strokeStyle = color; ctx.lineWidth = 2.5; ctx.stroke();
    ctx.lineTo(W, baseY); ctx.lineTo(0, baseY); ctx.closePath();
    ctx.fillStyle = color + Math.round(alpha * 255).toString(16).padStart(2, '0');
    ctx.fill();
  }

  drawFn(bimodal, '#7F77DD', 0.18);
  if (mode === 'forward') {
    drawFn(x => 0.55 * gaussian(x, 0.48, 0.23), '#1D9E75', 0.18);
    const el = document.getElementById('klModeExplain');
    if (el) el.textContent = 'Forward KL: Q (green) spreads wide to cover both peaks of P — it covers all modes but blurs precision.';
  } else {
    drawFn(x => gaussian(x, 0.26, 0.08), '#1D9E75', 0.18);
    const el = document.getElementById('klModeExplain');
    if (el) el.textContent = 'Reverse KL: Q (green) snaps to just one peak of P — sharp and confident, but ignores the other mode entirely.';
  }

  ctx.font = `500 11px "IBM Plex Mono", monospace`;
  ctx.fillStyle = '#7F77DD'; ctx.fillText('P — bimodal truth', 10, 16);
  ctx.fillStyle = '#1D9E75'; ctx.fillText('Q — approximation', 10, 30);
}

/* ─────────── Section index ─────────── */
const SECTIONS = [
  { id: 's0', label: 'Intro' },
  { id: 's1', label: 'Distributions' },
  { id: 's2', label: 'The Formula' },
  { id: 's3', label: 'Live Calc' },
  { id: 's4', label: 'KL in LLMs' },
  { id: 's5', label: 'Token by Token' },
  { id: 's6', label: 'Forward vs Reverse' },
  { id: 's7', label: 'Recap' },
];

let activeSectionId = SECTIONS[0].id;
let keyboardNavLock = false;

function buildSectionNav() {
  const list = document.getElementById('sectionIndex');
  if (!list) return;
  list.innerHTML = SECTIONS.map((s, i) =>
    `<li>
      <button type="button" class="section-index-item" data-index="${i}" data-target="${s.id}">
        ${s.label}
      </button>
    </li>`
  ).join('');

  list.querySelectorAll('.section-index-item').forEach(btn => {
    btn.addEventListener('click', () => goToSection(+btn.dataset.index));
  });
}

function getActiveSectionId() {
  const viewportMid = window.innerHeight / 2;
  let best = SECTIONS[0].id;
  let bestDist = Infinity;
  for (const s of SECTIONS) {
    const el = document.getElementById(s.id);
    if (!el) continue;
    const rect = el.getBoundingClientRect();
    const sectionMid = rect.top + rect.height / 2;
    const dist = Math.abs(sectionMid - viewportMid);
    if (dist < bestDist) {
      bestDist = dist;
      best = s.id;
    }
  }
  return best;
}

function goToSection(index) {
  const clamped = Math.max(0, Math.min(SECTIONS.length - 1, index));
  const el = document.getElementById(SECTIONS[clamped].id);
  if (!el) return;
  keyboardNavLock = true;
  activeSectionId = SECTIONS[clamped].id;
  updateSectionNav();
  el.scrollIntoView({ behavior: 'smooth' });
  window.setTimeout(() => { keyboardNavLock = false; }, 500);
}

function updateSectionNav() {
  if (!keyboardNavLock) activeSectionId = getActiveSectionId();

  const activeIndex = SECTIONS.findIndex(s => s.id === activeSectionId);
  document.querySelectorAll('.section-index-item').forEach((item, i) => {
    item.classList.toggle('active', i === activeIndex);
  });
}

function initSectionNav() {
  buildSectionNav();
  updateSectionNav();
  window.addEventListener('scroll', updateSectionNav, { passive: true });
  window.addEventListener('resize', updateSectionNav, { passive: true });

  window.addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
    if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement || e.target instanceof HTMLSelectElement) return;

    e.preventDefault();
    const current = SECTIONS.findIndex(s => s.id === activeSectionId);
    goToSection(e.key === 'ArrowDown' ? current + 1 : current - 1);
  });
}

/* ─────────── Progress bar ─────────── */
function initProgress() {
  const bar = document.getElementById('read-progress');
  if (!bar) return;
  window.addEventListener('scroll', () => {
    const doc = document.documentElement;
    const scrolled = doc.scrollTop / (doc.scrollHeight - doc.clientHeight);
    bar.style.width = (scrolled * 100).toFixed(1) + '%';
  }, { passive: true });
}

function initInteractions() {
  document.getElementById('tokenSentence')?.addEventListener('click', (e) => {
    const token = e.target.closest('[data-token-index]');
    if (token) selectToken(+token.dataset.tokenIndex);
  });

  document.getElementById('tokenSentence')?.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    const token = e.target.closest('[data-token-index]');
    if (!token) return;
    e.preventDefault();
    selectToken(+token.dataset.tokenIndex);
  });

  document.querySelectorAll('[data-kl-mode]').forEach(btn => {
    btn.addEventListener('click', () => showKLMode(btn.dataset.klMode));
  });

  document.getElementById('pPeak')?.addEventListener('input', updateMainDist);
  document.getElementById('qPeak')?.addEventListener('input', updateMainDist);
  ['p0', 'q0', 'split'].forEach(id => document.getElementById(id)?.addEventListener('input', computeKL));
}

/* ─────────── Init ─────────── */
window.addEventListener('load', () => {
  renderTokenSentence();
  initInteractions();
  updateMainDist();
  computeKL();
  showKLMode('forward');
  initSectionNav();
  initProgress();
});

window.addEventListener('resize', () => {
  updateMainDist();
  showKLMode(klMode);
});
</script>
