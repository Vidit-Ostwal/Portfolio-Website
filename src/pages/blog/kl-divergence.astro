    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.78rem;
  }
  :global(.calc-penalty-name) {
    font-weight: 500;
    color: var(--text);
  }
  :global(.calc-penalty-math) {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    min-width: 0;
  }
  :global(.calc-penalty-formula) {
    font-size: 0.66rem;
    color: var(--text-2);
    line-height: 1.35;
  }
  :global(.calc-penalty-evals) {
    font-size: 0.64rem;
    color: var(--text-3);
    line-height: 1.35;
  }
  :global(.calc-penalty-val) {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    font-weight: 500;
    color: #534AB7;
    white-space: nowrap;
  }
  :global([data-theme="dark"] .calc-penalty-val) { color: #9B93F0; }
  .calc-equation {
    margin-top: 0.55rem;
    padding: 0.55rem 0.65rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.72rem;
    color: var(--text-2);
    text-align: center;
  }
  .calc-equation strong {
    color: #534AB7;
    font-weight: 500;
  }
  :global([data-theme="dark"]) .calc-equation strong { color: #9B93F0; }

  @media (max-width: 720px) {
    .calc-body { grid-template-columns: 1fr; }
    :global(.calc-penalty-row) {
      grid-template-columns: 3.75rem 1fr auto;
      gap: 0.4rem;
    }
    :global(.calc-penalty-formula) { font-size: 0.62rem; }
    :global(.calc-penalty-evals) { font-size: 0.6rem; }
  }

  /* ── Token by Token (s6) — one viewport, no inner scroll ── */
