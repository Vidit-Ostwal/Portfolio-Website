---
import Layout from '../../layouts/Layout.astro';
import MobileTimelineNav from '../../components/MobileTimelineNav.astro';
import { substackPosts } from '../../data/projects';

const sortedPosts = [...substackPosts].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

function fmtDate(d: string) {
  return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}

function fmtDateShort(d: string) {
  return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
}
---

<Layout title="Blog — Vidit Ostwal">
<div class="page timeline-page">

  <div class="fade-in header">
    <h1>Writing</h1>
    <p class="sub">I share what I'm learning.</p>
  </div>

  <div class="timeline-wrap">
    <div class="timeline-spine" aria-hidden="true"></div>

    {sortedPosts.map((post) => (
      <div
        class="fade-in timeline-row"
        data-nav-label={post.title}
        data-nav-date={fmtDateShort(post.date)}
        data-nav-end={post.date}
        data-nav-start={post.date}
      >
        <div class="timeline-side">
          <div class="tl-marker">
            <span class="tl-dot"></span>
          </div>
          <div class="tl-dates mono">
            <span class="tl-end">{fmtDateShort(post.date)}</span>
            <span class="tl-sep">↓</span>
            <span class="tl-start">{post.category}</span>
          </div>
        </div>

        <a
          href={post.url}
          {...(post.url.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
          class="timeline-card post-card"
        >
          <p class="tl-dates-mobile mono">{fmtDate(post.date)} · {post.category}</p>
          <h2 class="post-title">{post.title}</h2>
          {post.summary && <p class="post-summary">{post.summary}</p>}
        </a>
      </div>
    ))}
  </div>

  <MobileTimelineNav ariaLabel="Jump between posts" />

</div>
</Layout>

<style>
  .header { margin-bottom: 3rem; }
  h1 { font-size: 1.9rem; font-weight: 600; letter-spacing: -0.025em; color: #111111; margin-bottom: 0.35rem; }
  .sub { font-size: 0.88rem; color: #999999; }

  .post-card {
    display: block;
    text-decoration: none;
  }

  .post-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: #111111;
    letter-spacing: -0.01em;
    line-height: 1.35;
    margin: 0 0 0.35rem;
  }

  .post-summary {
    font-size: 0.79rem;
    color: #666666;
    line-height: 1.55;
    margin: 0;
  }

  :global([data-theme="dark"]) h1 { color: #e8e8e8; }
  :global([data-theme="dark"]) .sub { color: #555555; }
  :global([data-theme="dark"]) .post-title { color: #e0e0e0; }
  :global([data-theme="dark"]) .post-summary { color: #808080; }
</style>
