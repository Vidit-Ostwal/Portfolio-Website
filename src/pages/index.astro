---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/paths';
---

<Layout title="Vidit Ostwal" description="ML/AI Engineer building agentic AI systems and RL environments.">
<div class="page">

  <!-- HERO -->
  <section class="fade-in hero">
    <div class="photo">
      <img src={withBase('/photo.jpg')} alt="Vidit Ostwal" />
    </div>
    <div class="hero-text">
      <p class="greeting mono">Hey, I'm</p>
      <h1>Vidit Ostwal</h1>
      <p class="tagline mono">ML / AI Engineer</p>
    </div>
    <div class="links">
        <!-- GitHub -->
        <a href="https://github.com/Vidit-Ostwal" target="_blank" rel="noopener" class="icon-link" aria-label="GitHub">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
          </svg>
          <span>GitHub</span>
        </a>
        <!-- LinkedIn -->
        <a href="https://www.linkedin.com/in/viditostwal/" target="_blank" rel="noopener" class="icon-link" aria-label="LinkedIn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
            <rect x="2" y="9" width="4" height="12"/>
            <circle cx="4" cy="4" r="2"/>
          </svg>
          <span>LinkedIn</span>
        </a>
        <!-- X -->
        <a href="https://x.com/ViditOstwal" target="_blank" rel="noopener" class="icon-link" aria-label="X">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
          <span>X</span>
        </a>
        <!-- Email -->
        <a href="mailto:viditostwal@gmail.com" class="icon-link" aria-label="Email">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
          <span>Email</span>
        </a>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="fade-in section">
    <h2 class="label mono">About</h2>
    <p class="about-text">
      ML Engineer with 3 years of experience, graduated from BITS Pilani. I specialise in agentic AI systems,
      reinforcement learning environments, and LLM evaluation — building the infrastructure that lets models
      plan, reason, and act over long horizons. Top 10 contributor to CrewAI (43k+ stars), with active work
      in RL fine-tuning, benchmark environments, and multi-agent coordination.
    </p>
  </section>

  <!-- ACHIEVEMENTS -->
  <section class="fade-in section">
    <h2 class="label mono">Recent Achievements</h2>
    <div class="hl-list">
      {[
        {
          title: 'Top 10 Contributor — CrewAI',
          sub: 'Multi-agent AI orchestration framework · 43k+ GitHub stars',
          href: 'https://github.com/crewAIInc/crewAI',
        },
        {
          title: '2nd Runner-Up — CrewAI Fall Hackathon',
          sub: 'Autonomous research & documentation generation pipeline',
          href: 'https://github.com/Vidit-Ostwal/MakeMyDocsBot',
        },
        {
          title: 'Technical Reviewer — CrewAI Book',
          sub: 'Official framework guide · publication forthcoming',
          href: null,
        },
      ].map(item => (
        <div class="hl-row">
          <div class="hl-title-row">
            <p class="hl-title">{item.title}</p>
            {item.href && (
              <a href={item.href} target="_blank" rel="noopener" class="hl-link mono" aria-label={`Link for ${item.title}`}>
                ↗
              </a>
            )}
          </div>
          <p class="hl-sub">{item.sub}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- OPEN SOURCE -->
  <section class="fade-in section">
    <h2 class="label mono">Open Source</h2>
    <div class="oss-list">

      <div class="oss-project">
        <div class="oss-project-header">
          <p class="oss-project-name">CrewAI Agent Framework</p>
          <a href="https://github.com/crewAIInc/crewAI" target="_blank" rel="noopener" class="oss-repo-link mono">crewAIInc/crewAI ↗</a>
        </div>
        <div class="pr-list">
          {[
            { pr: 'PR #2893', desc: 'Integrated Mem0 v2.0 memory library into CrewAI agent storage', href: 'https://github.com/crewAIInc/crewAI/pull/2893' },
            { pr: 'PR #2610', desc: 'Added maximum execution-time control for agent runs', href: 'https://github.com/crewAIInc/crewAI/pull/2610' },
            { pr: 'PR #2831', desc: 'Fixed agent knowledge-resolution logic for configured knowledge sources', href: 'https://github.com/crewAIInc/crewAI/pull/2831' },
          ].map(p => (
            <div class="pr-row">
              <a href={p.href} target="_blank" rel="noopener" class="pr-tag mono">{p.pr}</a>
              <p class="pr-desc">{p.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="oss-project">
        <div class="oss-project-header">
          <p class="oss-project-name">Prime Intellect — Agent Benchmarks</p>
          <a href="https://github.com/PrimeIntellect-ai" target="_blank" rel="noopener" class="oss-repo-link mono">PrimeIntellect-ai ↗</a>
        </div>
        <div class="pr-list">
          {[
            { pr: 'PR #500', desc: 'Integrated Mecor AI Apex Agents benchmark into verifier environments', href: '#' },
            { pr: 'PR #363', desc: 'Improvements to community agent benchmarking environments', href: '#' },
          ].map(p => (
            <div class="pr-row">
              <a href={p.href} target="_blank" rel="noopener" class="pr-tag mono">{p.pr}</a>
              <p class="pr-desc">{p.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="oss-project">
        <div class="oss-project-header">
          <p class="oss-project-name">Gemma-3 Vision — QLoRA Training</p>
        </div>
        <div class="pr-list">
          {[
            { pr: 'PR #13', desc: 'Added QLoRA training support for Gemma-3 object detection pipeline', href: '#' },
          ].map(p => (
            <div class="pr-row">
              <a href={p.href} target="_blank" rel="noopener" class="pr-tag mono">{p.pr}</a>
              <p class="pr-desc">{p.desc}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

</div>
</Layout>

<style>
  /* ── Base ── */
  .page { max-width: 700px; margin: 0 auto; padding: 5.5rem 1.5rem 5rem; }
  .mono { font-family: "IBM Plex Mono", monospace; }

  /* ── Hero (grid: desktop photo | text+links; mobile photo+text then full-width links) ── */
  .hero {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: 2.25rem;
    row-gap: 1.05rem;
    align-items: start;
    justify-items: stretch;
    width: 100%;
    margin-bottom: 4.5rem;
  }

  .photo {
    grid-column: 1;
    grid-row: 1 / span 2;
    width: 132px;
    height: 132px;
    border-radius: 50%;
    background: #f0f0f0;
    border: 1px solid #e0e0e0;
    overflow: hidden;
    justify-self: start;
    align-self: center;
  }
  .photo img { width: 100%; height: 100%; object-fit: cover; }

  .hero-text {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
    width: 100%;
  }

  .links {
    grid-column: 2;
    grid-row: 2;
    width: 100%;
    min-width: 0;
    display: flex;
    align-items: stretch;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .greeting {
    font-size: 0.78rem;
    color: #888888;
    letter-spacing: 0.04em;
    margin-bottom: 0.35rem;
  }

  h1 {
    font-size: 2.05rem;
    font-weight: 600;
    letter-spacing: -0.035em;
    color: #111111;
    margin-bottom: 0.35rem;
    line-height: 1.08;
  }

  .tagline {
    font-size: 0.76rem;
    color: #888888;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0;
  }

  /* ── Social link buttons ── */
  .icon-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: #444444;
    text-decoration: none;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    padding: 0.5rem 0.75rem;
    border: 1px solid #e4e4e4;
    border-radius: 7px;
    background: #ffffff;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
    flex-shrink: 0;
  }
  .icon-link:hover {
    color: #111111;
    border-color: #cccccc;
    background: #f7f7f7;
  }

  /* ── Section scaffold ── */
  .section { margin-bottom: 3.5rem; }
  .label {
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #bbbbbb;
    margin-bottom: 1.1rem;
  }

  /* ── About ── */
  .about-text {
    font-size: 0.9rem;
    color: #444444;
    line-height: 1.8;
    max-width: 640px;
  }

  /* ── Achievements ── */
  .hl-list { display: flex; flex-direction: column; }
  .hl-row {
    padding: 0.9rem 0;
    border-bottom: 1px solid #eeeeee;
  }
  .hl-row:first-child { border-top: 1px solid #eeeeee; }
  .hl-title-row { display: flex; align-items: baseline; gap: 0.6rem; margin-bottom: 0.2rem; }
  .hl-title { font-size: 0.87rem; font-weight: 500; color: #111111; }
  .hl-link {
    font-size: 0.75rem;
    color: #bbbbbb;
    text-decoration: none;
    transition: color 0.15s;
    line-height: 1;
  }
  .hl-link:hover { color: #111111; }
  .hl-sub { font-size: 0.77rem; color: #aaaaaa; }

  /* ── Open Source ── */
  .oss-list { display: flex; flex-direction: column; gap: 2rem; }

  .oss-project-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }
  .oss-project-name {
    font-size: 0.87rem;
    font-weight: 500;
    color: #111111;
  }
  .oss-repo-link {
    font-size: 0.67rem;
    color: #bbbbbb;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color 0.15s;
  }
  .oss-repo-link:hover { color: #111111; }

  .pr-list { display: flex; flex-direction: column; gap: 0.55rem; padding-left: 0; }

  .pr-row { display: flex; align-items: baseline; gap: 0.75rem; }

  .pr-tag {
    font-size: 0.68rem;
    color: #888888;
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid #e4e4e4;
    border-radius: 3px;
    padding: 0.1rem 0.4rem;
    transition: border-color 0.15s, color 0.15s;
    flex-shrink: 0;
  }
  .pr-tag:hover { color: #111111; border-color: #aaaaaa; }

  .pr-desc { font-size: 0.81rem; color: #555555; line-height: 1.5; }

  /* ── Mobile: photo + name on row 1; icon buttons full width row 2 ── */
  @media (max-width: 520px) {
    .page { padding: 3.5rem 1.25rem 4rem; }

    .hero {
      grid-template-columns: 100px minmax(0, 1fr);
      column-gap: 1rem;
      row-gap: 1.15rem;
      align-items: start;
      justify-items: stretch;
      width: 100%;
      margin-bottom: 3rem;
    }

    .photo {
      grid-column: 1;
      grid-row: 1;
      width: 100px;
      height: 100px;
      align-self: center;
    }

    .hero-text {
      grid-column: 2;
      grid-row: 1;
      width: 100%;
      align-self: center;
    }

    .links {
      grid-column: 1 / -1;
      grid-row: 2;
      width: 100%;
      justify-content: flex-start;
      gap: 0.45rem;
    }

    h1 { font-size: 1.65rem; }

    .greeting { font-size: 0.72rem; }
    .tagline { font-size: 0.7rem; }

    .icon-link {
      padding: 0.5rem;
      gap: 0;
      justify-content: center;
      min-width: 2.65rem;
      min-height: 2.65rem;
      font-size: 0;
    }
    .icon-link span { display: none; }
    .icon-link svg { display: block; flex-shrink: 0; }

    .oss-project-header { flex-direction: column; gap: 0.25rem; }

    .pr-row { align-items: flex-start; flex-direction: column; gap: 0.3rem; }
  }
</style>