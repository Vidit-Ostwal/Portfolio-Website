---
import Layout from '../layouts/Layout.astro';
import { experience } from '../data/experience';
---

<Layout title="Experience — Vidit Ostwal">
<div class="page">

  <div class="fade-in header">
    <h1>Experience</h1>
    <p class="sub">Full-time roles and what I built.</p>
  </div>

  <div class="roles">
    {experience.map((role, i) => (
      <div class={`fade-in role ${i < experience.length - 1 ? 'bordered' : ''}`}>
        <div class="role-meta">
          <span class="period mono">{role.period}</span>
          {role.current && <span class="badge mono">now</span>}
        </div>
        <div class="role-body">
          <div class="role-title-row">
            <h2 class="role-title">{role.title}</h2>
            <span class="company">{role.company}</span>
          </div>
          <ul class="bullets">
            {role.bullets.map(b => <li>{b}</li>)}
          </ul>
        </div>
      </div>
    ))}
  </div>

</div>
</Layout>

<style>
  .page { max-width: 680px; margin: 0 auto; padding: 7rem 1.5rem 2rem; }

  .header { margin-bottom: 3rem; }
  h1 { font-size: 1.9rem; font-weight: 600; letter-spacing: -0.025em; color: #111111; margin-bottom: 0.35rem; }
  .sub { font-size: 0.88rem; color: #999999; }

  .roles { display: flex; flex-direction: column; }

  .role { display: grid; grid-template-columns: 150px 1fr; gap: 2rem; padding: 2rem 0; }
  .role.bordered { border-bottom: 1px solid #e4e4e4; }

  .role-meta { display: flex; flex-direction: column; gap: 0.5rem; padding-top: 0.1rem; }

  .mono { font-family: "IBM Plex Mono", monospace; }

  .period { font-size: 0.7rem; color: #999999; line-height: 1.5; }

  .badge {
    display: inline-block; font-size: 0.6rem; letter-spacing: 0.05em;
    color: #555555; border: 1px solid #e4e4e4; border-radius: 3px;
    padding: 0.1rem 0.45rem; width: fit-content;
  }

  .role-title-row { margin-bottom: 0.85rem; }
  .role-title { font-size: 0.95rem; font-weight: 600; color: #111111; margin-bottom: 0.2rem; }
  .company { font-size: 0.82rem; color: #555555; }

  .bullets { list-style: none; display: flex; flex-direction: column; gap: 0.55rem; }
  .bullets li { font-size: 0.85rem; color: #555555; line-height: 1.65; padding-left: 1rem; position: relative; }
  .bullets li::before { content: '–'; position: absolute; left: 0; color: #cccccc; }

  @media (max-width: 520px) {
    .role { grid-template-columns: 1fr; gap: 0.6rem; }
  }
</style>
